  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f66da91d733d42bb91b479ff9bb84c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StageIntroSequence
  player: {fileID: 290047753}
  playerInteractor: {fileID: 290047759}
  barrier: {fileID: 213731343}
  playerStagePosition: {fileID: 529774985}
  quark: {fileID: 289876309}
  portalOpener: {fileID: 631079067}
  playerReturnPosition: {fileID: 1944233191}
  pedestal: {fileID: 587069413}
  pedestalTargetPosition: {fileID: 1016374569}
  pedestalMoveDuration: 1.5
  speechLines:
  - Thank you all for being here. My name is Dr. Elena Voss, and I'm the lead scientist
    behind this project.
  - 'For years, everything we''re about to show you existed only on paper: equations,
    simulations, theories. Nobody outside this building believed in.'
  - Tonight, that changes. Today, humanity takes its first real step beyond the world
    it has always known.
  - Behind me is Q.U.A.R.K., the device you've heard about in every briefing, every
    report, every closed-door meeting that brought you into this room.
  - In a few moments, it will open a door to somewhere no human being has ever set
    foot.
  - Every great leap humanity has taken began the same way, with someone brave enough
    to go first, and the rest of us watching, holding our breath.
  - Today, that person stands right here among us.
  - The stage is yours. Let's make history.
  advanceAction: {fileID: 1781555164194001046, guid: 2bcd2660ca9b64942af0de543d8d7100, type: 3}
  audioSource: {fileID: 196466439}
  playerTag: Player

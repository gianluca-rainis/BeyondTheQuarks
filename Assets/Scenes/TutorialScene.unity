  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7774455b6bcae45149403d0f7c4e57db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  lines:
  - (NASA administrator) We built Q.U.A.R.K. from the ground up in our own labs,
    and tonight the whole world finally gets to see why it mattered.
  - (NASA administrator) This agency put a man on the Moon over half a century ago.
    Tonight we're opening the door to entire universes.
  - (NASA administrator) This is bigger than the space program ever dared to dream.
  - (NASA administrator) Every dollar, every delay, every skeptic in Congress, all
    of it led to this exact moment on this exact stage.
